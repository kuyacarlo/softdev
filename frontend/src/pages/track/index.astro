---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Track Reservation Status | Casa de Stella"
  description="Check real-time confirmation status and event logistics for your catering reservation."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-xl mx-auto text-center space-y-4 mb-10">
      <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-amber-900 mx-auto font-bold text-xl">
        🔍
      </div>
      <h1 class="text-3xl font-serif font-bold text-stone-900">Track Your Reservation</h1>
      <p class="text-sm text-stone-600 leading-relaxed">
        Enter the private tracking token provided when you submitted your booking request to view live review status and package details.
      </p>
    </div>

    <div class="max-w-md mx-auto bg-white p-8 rounded-2xl border border-stone-200 shadow-sm">
      <form id="track-form" class="space-y-4">
        <div>
          <label for="token-input" class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">
            Tracking Token
          </label>
          <input
            type="text"
            id="token-input"
            placeholder="e.g. 124dcdac-2fff-44cb-873b-a7cfc761f180"
            class="w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-stone-900 font-mono focus:outline-none focus:ring-2 focus:ring-stone-900"
            required
          />
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 rounded-lg text-sm font-semibold text-white bg-stone-900 hover:bg-stone-800 transition-all shadow-sm"
        >
          Check Live Status
        </button>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('track-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('token-input') as HTMLInputElement;
      const token = input?.value?.trim();
      if (token) {
        window.location.href = `/track/${encodeURIComponent(token)}`;
      }
    });
  </script>
</BaseLayout>
