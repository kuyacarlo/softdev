---
import BaseLayout from '../layouts/BaseLayout.astro';
import PackageCard from '../components/PackageCard.astro';
import { getPackages } from '../lib/api-client';
import { EVENT_CATEGORIES, type EventCategory } from '@stella/schema';

const selectedCategory = Astro.url.searchParams.get('category') || undefined;

let packages = [];
try {
  packages = await getPackages(selectedCategory);
} catch {
  packages = [];
}
---

<BaseLayout
  title="Catering Packages Catalog | Casa de Stella"
  description="Explore our comprehensive catering package tiers for Weddings, Debuts, Birthdays, Corporate events, and Special celebrations."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mb-10">
      <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Full Service Catalog</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 mt-1 mb-4">
        Catering Packages & Menu Inclusions
      </h1>
      <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
        Select a category below to filter our catering tiers. Every package includes full buffet styling, dedicated waitstaff, and tableware.
      </p>
    </div>

    {/* Category Filter Pills */}
    <div class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-stone-200">
      <a
        href="/packages"
        class={`px-4 py-2 rounded-full text-xs font-medium transition-all ${
          !selectedCategory
            ? 'bg-stone-900 text-white shadow-sm'
            : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-100'
        }`}
      >
        All Packages
      </a>
      {EVENT_CATEGORIES.map((cat) => (
        <a
          href={`/packages?category=${encodeURIComponent(cat)}`}
          class={`px-4 py-2 rounded-full text-xs font-medium transition-all ${
            selectedCategory === cat
              ? 'bg-stone-900 text-white shadow-sm'
              : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-100'
          }`}
        >
          {cat}
        </a>
      ))}
    </div>

    {/* Package Cards Grid */}
    {packages.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {packages.map((pkg) => (
          <PackageCard pkg={pkg} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-xl border border-stone-200 p-8">
        <p class="text-stone-500 text-sm">No packages currently available under this category.</p>
        <a href="/packages" class="mt-4 inline-block text-xs font-semibold text-amber-700 hover:underline">
          View all packages
        </a>
      </div>
    )}
  </div>
</BaseLayout>
